
module bythos;

//* -- Structures -- *//
struct Material {
  Shader shader;
  MaterialMap[12] maps;
}
struct MaterialMap {
  //Texture texture;
  Vec3f value;
}


module bythos::material;

//* -- Constants -- *//
const usz DIFFUSE    = 0;
const usz METALNESS  = 1;
const usz NORMAL     = 2;
const usz ROUGHNESS  = 3;
const usz OCCLUSION  = 4;
const usz EMISSION   = 5;
const usz HEIGHT     = 6;
const usz CUBEMAP    = 7;
const usz IRRADIANCE = 8;
const usz PREFILTER  = 9;
const usz BRDF       = 10;

//* -- Functions -- *//
extern fn Material new() @extern("material_new");
extern fn void Material.clean(&self) @extern("material_clean");
extern fn bool Material.is_valid(&self) @extern("material_valid")

