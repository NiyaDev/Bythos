
module bythos;

//* -- Structures -- *//
struct Texture {
  uint id;
  uint w, h;
}

//* -- Enums -- *//
enum TilingLayout {
  THREE_THREE,
  ONE_THREE,
  THREE_ONE,
}


module bythos::texture;

//* -- Functions -- *//
extern fn Texture load(String filename) @extern("texture_load");
extern fn Texture load_from_mem(char[] data) @extern("texture_loadfrommem");
extern fn Texture new(int width, int height) @extern("texture_new");
extern fn void Texture.clean(&self) @extern("texture_clean");
extern fn bool Texture.is_valid(&self) @extern("texture_isvalid");

extern fn char[] Texture.get_raw(&self) @extern("texture_getraw");
extern fn void Texture.save(&self, String filename = "texture.ppm") @extern("texture_save");

