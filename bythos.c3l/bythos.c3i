
module bythos;
import sdl3;

//* -- Bythos -- *//
extern const String VERSION @extern("version");

extern fn void run_timer()    @extern("bythos_runtimer");
extern fn void handle_keys()  @extern("bythos_handlekeys");
extern fn bool parse_events() @extern("bythos_parseevents");
extern fn void frame_delay()  @extern("bythos_framedelay");
extern fn void draw_start()   @extern("bythos_drawstart");
extern fn void draw_end()     @extern("bythos_drawend");

extern fn void init()  @extern("bythos_init");
extern fn void clean() @extern("bythos_clean");

macro void @loop(; @body()) {
  while (true) {
    //* -- Timing -- *//
    run_timer();

    //* -- Handle Keys -- *//
    bythos::handle_keys();

    //* -- Main Camera -- *//
    Camera.update();

  	//* -- Events -- *//
  	if (parse_events()) break;

  	//* -- Body -- *//
  	draw_start();
    @body();
  	draw_end();

  	//* -- Frame delay -- *//
  	frame_delay();
  }
}

