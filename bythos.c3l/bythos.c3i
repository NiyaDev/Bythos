
module bythos;
import sdl3;

//* -- Bythos -- *//
struct Bythos {
  Window* window;
  GLContext* context;
  Renderer* renderer;

  Vec2i display, screen, render;

  uint framebuffer, renderbuffer;
  Mesh quad;
  Material quadMat;

  Shader defaultShader2d, defaultShader3d;
  //Texture defaultTexture;
  Mesh defaultMesh, textureMesh;
  Material defaultMaterial;

  struct time {
    double deltaTime, lastFrame;
    double targetFrametime;
  }
  struct gpu {
    String vendor, renderer, version, glsl;
    int shaderBinaries;
  }
}

extern const String VERSION @extern("version");
extern Bythos core @extern("core") @private;

extern fn void run_timer()    @extern("bythos_runtimer")    @private;
extern fn bool parse_events() @extern("bythos_parseevents") @private;
extern fn void frame_delay()  @extern("bythos_framedelay")  @private;
extern fn void draw_start()   @extern("bythos_drawstart")   @private;
extern fn void draw_end()     @extern("bythos_drawend")     @private;

extern fn void init()  @extern("bythos_init");
extern fn void clean() @extern("bythos_clean");

macro void @loop(; @body()) {
  while (true) {
    //* -- Timing -- *//
    run_timer();

  	//* -- Events -- *//
  	if (parse_events()) break;

  	//* -- Body -- *//
  	draw_start();
    @body();
  	draw_end();

  	//* -- Frame delay -- *//
  	frame_delay();
  }
}

