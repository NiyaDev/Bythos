
module bythos;
import std::collections;

//* -- Structures -- *//
struct Shader {
  uint id;
  HashMap{String, uint} locs;
}


module bythos::shader;
import std::math;

//* -- Functions -- *//
extern fn Shader load(String v, String f) @extern("shader_load");
extern fn Shader compile(char[] v, char[] f) @extern("shader_compile");
extern fn void Shader.clean(&self) @extern("shader_clean");

extern fn void Shader.set_int(&self, String key, int v) @extern("shader_setint");
extern fn void Shader.set_float(&self, String key, float v) @extern("shader_setfloat");
extern fn void Shader.set_vec2(&self, String key, Vec2f v) @extern("shader_setvec2");
extern fn void Shader.set_vec3(&self, String key, Vec3f v) @extern("shader_setvec3");
extern fn void Shader.set_vec4v(&self, String key, Vec4f v) @extern("shader_setvec4");
extern fn void Shader.set_matrix(&self, String key, Matrix4f v) @extern("shader_setmatrix");

